@model StationeryWarehouse.Models.Transfer.TransferFormViewModel

@{
    ViewData["Title"] = "Chi tiết điều chuyển";

    var canOperate =
        User.IsInRole("ADMIN")
        || User.IsInRole("WAREHOUSE_MANAGER")
        || User.IsInRole("WAREHOUSE_OPERATOR");
}

<div class="container-fluid py-3">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }


    <div class="d-flex justify-content-between
                align-items-center mb-3">

        <div>

            <h4 class="mb-1">

                <i class="bi bi-arrow-left-right"></i>

                @Model.TransferNo

            </h4>

            <div class="text-muted small">
                Chi tiết phiếu điều chuyển
            </div>

        </div>


        <div class="d-flex gap-2">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left"></i>
                Danh sách

            </a>

            @if (Model.Status == "DRAFT"
                && canOperate)
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-primary">

                    <i class="bi bi-pencil"></i>
                    Sửa

                </a>
            }

        </div>

    </div>


    <div class="card shadow-sm mb-3">

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-3">

                    <div class="text-muted small">
                        Số phiếu
                    </div>

                    <div class="fw-semibold">
                        @Model.TransferNo
                    </div>

                </div>


                <div class="col-md-3">

                    <div class="text-muted small">
                        Ngày điều chuyển
                    </div>

                    <div class="fw-semibold">
                        @Model.TransferDate.ToString("dd/MM/yyyy")
                    </div>

                </div>


                <div class="col-md-3">

                    <div class="text-muted small">
                        Kho nguồn
                    </div>

                    <div class="fw-semibold">

                        @{
                            var sourceWarehouse =
                                Model.Warehouses
                                    .FirstOrDefault(
                                        x =>
                                            x.Id ==
                                            Model.SourceWarehouseId);
                        }

                        @if (sourceWarehouse != null)
                        {
                            @sourceWarehouse.Code
                            <text> - </text>
                            @sourceWarehouse.Name
                        }

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="text-muted small">
                        Kho đích
                    </div>

                    <div class="fw-semibold">

                        @{
                            var destinationWarehouse =
                                Model.Warehouses
                                    .FirstOrDefault(
                                        x =>
                                            x.Id ==
                                            Model.DestinationWarehouseId);
                        }

                        @if (destinationWarehouse != null)
                        {
                            @destinationWarehouse.Code
                            <text> - </text>
                            @destinationWarehouse.Name
                        }

                    </div>

                </div>


                <div class="col-md-3">

                    <div class="text-muted small">
                        Trạng thái
                    </div>

                    <div>

                        @switch (Model.Status)
                        {
                            case "DRAFT":
                                <span class="badge bg-secondary">
                                    Nháp
                                </span>
                                break;

                            case "DONE":
                                <span class="badge bg-success">
                                    Hoàn tất
                                </span>
                                break;

                            case "CANCELLED":
                                <span class="badge bg-danger">
                                    Đã hủy
                                </span>
                                break;

                            default:
                                <span class="badge bg-secondary">
                                    @Model.Status
                                </span>
                                break;
                        }

                    </div>

                </div>


                <div class="col-md-9">

                    <div class="text-muted small">
                        Ghi chú
                    </div>

                    <div>
                        @(string.IsNullOrWhiteSpace(Model.Note)
                            ? "—"
                            : Model.Note)
                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="card shadow-sm mb-3">

        <div class="card-header bg-white">

            <strong>
                Chi tiết sản phẩm
            </strong>

        </div>


        <div class="table-responsive">

            <table class="table table-bordered
                          align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>
                            Sản phẩm
                        </th>

                        <th>
                            Barcode
                        </th>

                        <th>
                            Bin nguồn
                        </th>

                        <th>
                            Tồn nguồn
                        </th>

                        <th>
                            Bin đích
                        </th>

                        <th class="text-end">
                            Số lượng
                        </th>

                    </tr>

                </thead>


                <tbody>

                @if (Model.Lines.Any())
                {
                    foreach (var line in Model.Lines)
                    {
                        <tr>

                            <td>
                                @line.ProductDisplay
                            </td>

                            <td>
                                @(
                                    string.IsNullOrWhiteSpace(
                                        line.ProductBarcode)
                                        ? "—"
                                        : line.ProductBarcode
                                )
                            </td>

                            <td>
                                @line.SourceLocationDisplay
                            </td>

                            <td>
                                @line.SourceStock
                            </td>

                            <td>
                                @line.DestinationLocationDisplay
                            </td>

                            <td class="text-end fw-semibold">
                                @line.Quantity
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="6"
                            class="text-center text-muted py-4">

                            Phiếu chưa có sản phẩm.

                        </td>

                    </tr>
                }

                </tbody>

            </table>

        </div>

    </div>


    @if (Model.Status == "DRAFT" && canOperate)
    {
        <div class="card shadow-sm">

            <div class="card-body">

                <div class="d-flex justify-content-end gap-2">

                    <form asp-action="Cancel"
                          method="post"
                          onsubmit="return confirm('Bạn có chắc muốn hủy phiếu này?');">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-outline-danger">

                            <i class="bi bi-x-circle"></i>
                            Hủy phiếu

                        </button>

                    </form>


                    <form asp-action="Complete"
                          method="post"
                          onsubmit="return confirm('Bạn có chắc muốn hoàn tất điều chuyển? Sau khi hoàn tất, phiếu không thể sửa.');">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />

                        <button type="submit"
                                class="btn btn-success">

                            <i class="bi bi-check-circle"></i>
                            Hoàn tất điều chuyển

                        </button>

                    </form>

                </div>

            </div>

        </div>
    }

</div>
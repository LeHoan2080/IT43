@model StationeryWarehouse.Models.Transfer.TransferFormViewModel

<div class="card shadow-sm mb-3">

    <div class="card-header bg-white">
        <strong>
            Thông tin điều chuyển
        </strong>
    </div>

    <div class="card-body">

        <div class="row g-3">

            <div class="col-md-3">

                <label class="form-label">
                    Số phiếu
                </label>

                <input asp-for="TransferNo"
                       class="form-control"
                       placeholder="Tự động sinh"
                       readonly />

            </div>

            <div class="col-md-3">

                <label asp-for="TransferDate"
                       class="form-label">
                    Ngày điều chuyển
                </label>

                <input asp-for="TransferDate"
                       type="date"
                       class="form-control" />

            </div>

            <div class="col-md-3">

                <label asp-for="SourceWarehouseId"
                       class="form-label">
                    Kho nguồn
                    <span class="text-danger">*</span>
                </label>

                <select asp-for="SourceWarehouseId"
                        class="form-select"
                        id="sourceWarehouse">

                    <option value="">
                        -- Chọn kho nguồn --
                    </option>

                    @foreach (var warehouse in Model.Warehouses)
                    {
                        <option value="@warehouse.Id">
                            @warehouse.Code - @warehouse.Name
                        </option>
                    }

                </select>

            </div>

            <div class="col-md-3">

                <label asp-for="DestinationWarehouseId"
                       class="form-label">
                    Kho đích
                    <span class="text-danger">*</span>
                </label>

                <select asp-for="DestinationWarehouseId"
                        class="form-select"
                        id="destinationWarehouse">

                    <option value="">
                        -- Chọn kho đích --
                    </option>

                    @foreach (var warehouse in Model.Warehouses)
                    {
                        <option value="@warehouse.Id">
                            @warehouse.Code - @warehouse.Name
                        </option>
                    }

                </select>

            </div>

            <div class="col-12">

                <label asp-for="Note"
                       class="form-label">
                    Ghi chú
                </label>

                <textarea asp-for="Note"
                          class="form-control"
                          rows="2"
                          placeholder="Ghi chú điều chuyển..."></textarea>

            </div>

        </div>

    </div>

</div>


<div class="card shadow-sm mb-3">

    <div class="card-header bg-white
                d-flex justify-content-between
                align-items-center">

        <strong>
            Chi tiết sản phẩm
        </strong>

        <button type="button"
                class="btn btn-sm btn-primary"
                id="btnAddLine">

            <i class="bi bi-plus-lg"></i>
            Thêm sản phẩm

        </button>

    </div>

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-bordered
                          align-middle mb-0"
                   id="transferLinesTable">

                <thead class="table-light">

                    <tr>

                        <th style="width: 20%">
                            Sản phẩm
                        </th>

                        <th style="width: 15%">
                            Barcode
                        </th>

                        <th style="width: 20%">
                            Bin nguồn
                        </th>

                        <th style="width: 20%">
                            Bin đích
                        </th>

                        <th style="width: 10%"
                            class="text-end">
                            Tồn nguồn
                        </th>

                        <th style="width: 10%"
                            class="text-end">
                            Số lượng
                        </th>

                        <th style="width: 5%">
                        </th>

                    </tr>

                </thead>

                <tbody id="transferLinesBody">

                    @if (Model.Lines != null &&
                         Model.Lines.Count > 0)
                    {
                        for (var i = 0;
                             i < Model.Lines.Count;
                             i++)
                        {
                            <tr class="transfer-line">

                                <td>

                                    <input type="hidden"
                                           name="Lines[@i].Id"
                                           value="@Model.Lines[i].Id" />

                                    <input type="hidden"
                                           name="Lines[@i].ProductId"
                                           class="product-id"
                                           value="@Model.Lines[i].ProductId" />

                                    <div class="input-group">

                                        <input type="text"
                                               class="form-control product-search"
                                               value="@Model.Lines[i].ProductDisplay"
                                               placeholder="Quét / nhập barcode..." />

                                        <button type="button"
                                                class="btn btn-outline-secondary btn-search-product">
                                            <i class="bi bi-search"></i>
                                        </button>

                                    </div>

                                    <div class="product-results"></div>

                                </td>

                                <td>

                                    <input type="text"
                                           name="Lines[@i].ProductBarcode"
                                           class="form-control product-barcode"
                                           value="@Model.Lines[i].ProductBarcode"
                                           readonly />

                                </td>

                                <td>

                                    <input type="hidden"
                                           name="Lines[@i].SourceLocationId"
                                           class="source-location-id"
                                           value="@Model.Lines[i].SourceLocationId" />

                                    <div class="input-group">

                                        <input type="text"
                                               class="form-control source-location-search"
                                               value="@Model.Lines[i].SourceLocationDisplay"
                                               placeholder="Quét Barcode Bin..." />

                                        <button type="button"
                                                class="btn btn-outline-secondary btn-search-source-location">
                                            <i class="bi bi-search"></i>
                                        </button>

                                    </div>

                                    <div class="source-location-results"></div>

                                </td>

                                <td>

                                    <input type="hidden"
                                           name="Lines[@i].DestinationLocationId"
                                           class="destination-location-id"
                                           value="@Model.Lines[i].DestinationLocationId" />

                                    <div class="input-group">

                                        <input type="text"
                                               class="form-control destination-location-search"
                                               value="@Model.Lines[i].DestinationLocationDisplay"
                                               placeholder="Quét Barcode Bin..." />

                                        <button type="button"
                                                class="btn btn-outline-secondary btn-search-destination-location">
                                            <i class="bi bi-search"></i>
                                        </button>

                                    </div>

                                    <div class="destination-location-results"></div>

                                </td>

                                <td class="text-end">

                                    <span class="source-stock">
                                        @Model.Lines[i].SourceStock
                                    </span>

                                </td>

                                <td>

                                    <input type="number"
                                           name="Lines[@i].Quantity"
                                           class="form-control quantity text-end"
                                           min="1"
                                           value="@Model.Lines[i].Quantity" />

                                </td>

                                <td class="text-center">

                                    <button type="button"
                                            class="btn btn-sm btn-outline-danger btn-remove-line">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<div class="d-flex justify-content-between align-items-center">

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-x-lg"></i>
        Hủy

    </a>

    <div class="d-flex gap-2">

        <button type="submit"
                class="btn btn-primary">

            <i class="bi bi-save"></i>
            Lưu phiếu

        </button>

    </div>

</div>
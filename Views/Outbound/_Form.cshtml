@model StationeryWarehouse.Models.Outbound.OutboundFormViewModel

@{
    bool isDraft = Model.Status == "DRAFT";
    bool canEdit = isDraft;
}

<div class="card shadow-sm border-0">

    <!-- STATUSBAR -->
    <div class="card-header bg-white border-bottom">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <span class="text-muted me-2">
                    Trạng thái:
                </span>

                @switch (Model.Status)
                {
                    case "DRAFT":
                        <span class="badge bg-secondary">
                            Nháp
                        </span>
                        break;

                    case "PICKING":
                        <span class="badge bg-warning text-dark">
                            Đang lấy hàng
                        </span>
                        break;

                    case "DONE":
                        <span class="badge bg-success">
                            Hoàn tất
                        </span>
                        break;

                    case "CANCELLED":
                        <span class="badge bg-danger">
                            Đã hủy
                        </span>
                        break;
                }

            </div>

            @if (!string.IsNullOrWhiteSpace(Model.IssueNo))
            {
                <div class="fw-semibold">
                    @Model.IssueNo
                </div>
            }

        </div>

    </div>


    <!-- HEADER -->
    <div class="card-body">

        <div class="row g-3">

            <div class="col-md-4">

                <label asp-for="WarehouseId"
                       class="form-label">
                    Kho xuất <span class="text-danger">*</span>
                </label>

                <select asp-for="WarehouseId"
                        class="form-select"
                        disabled="@(!canEdit)">

                    <option value="">
                        -- Chọn kho --
                    </option>

                    @foreach (var warehouse in Model.Warehouses)
                    {
                        <option value="@warehouse.Id">
                            @warehouse.Code - @warehouse.Name
                        </option>
                    }

                </select>

                @if (!canEdit)
                {
                    <input type="hidden"
                           asp-for="WarehouseId" />
                }

                <span asp-validation-for="WarehouseId"
                      class="text-danger"></span>

            </div>


            <div class="col-md-4">

                <label asp-for="IssueReason"
                       class="form-label">
                    Lý do xuất <span class="text-danger">*</span>
                </label>

                <select asp-for="IssueReason"
                        class="form-select"
                        disabled="@(!canEdit)">

                    <option value="">
                        -- Chọn lý do --
                    </option>

                    <option value="SALE">
                        Xuất bán
                    </option>

                    <option value="INTERNAL">
                        Xuất nội bộ
                    </option>

                    <option value="OTHER">
                        Khác
                    </option>

                </select>

                @if (!canEdit)
                {
                    <input type="hidden"
                           asp-for="IssueReason" />
                }

                <span asp-validation-for="IssueReason"
                      class="text-danger"></span>

            </div>


            <div class="col-md-4">

                <label asp-for="IssueDate"
                       class="form-label">
                    Ngày xuất <span class="text-danger">*</span>
                </label>

                <input asp-for="IssueDate"
                       type="date"
                       class="form-control"
                       disabled="@(!canEdit)" />

                @if (!canEdit)
                {
                    <input type="hidden"
                           asp-for="IssueDate" />
                }

                <span asp-validation-for="IssueDate"
                      class="text-danger"></span>

            </div>


            <div class="col-12">

                <label asp-for="Note"
                       class="form-label">
                    Ghi chú
                </label>

                <textarea asp-for="Note"
                          class="form-control"
                          rows="2"
                          maxlength="1000"
                          disabled="@(!canEdit)"></textarea>

                @if (!canEdit)
                {
                    <input type="hidden"
                           asp-for="Note" />
                }

            </div>

        </div>

    </div>


    <!-- LINES -->
    <div class="card-body border-top">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>
                <h6 class="mb-1">
                    Danh sách sản phẩm
                </h6>

                <small class="text-muted">
                    Chọn sản phẩm và Bin có tồn để lấy hàng.
                </small>
            </div>

            @if (canEdit)
            {
                <button type="button"
                        id="btnAddLine"
                        class="btn btn-outline-primary btn-sm">

                    <i class="bi bi-plus-lg"></i>
                    Thêm dòng

                </button>
            }

        </div>


        <div class="table-responsive">

            <table class="table table-bordered align-middle"
                   id="outboundLinesTable">

                <thead class="table-light">

                    <tr>

                        <th style="min-width: 260px;">
                            Sản phẩm
                        </th>

                        <th style="width: 180px;">
                            Barcode
                        </th>

                        <th style="min-width: 240px;">
                            Bin
                        </th>

                        <th style="width: 130px;"
                            class="text-end">
                            Tồn
                        </th>

                        <th style="width: 140px;">
                            SL yêu cầu
                        </th>

                        <th style="width: 140px;">
                            SL đã lấy
                        </th>

                        <th style="width: 60px;">
                        </th>

                    </tr>

                </thead>

                <tbody id="outboundLinesBody">

                    @if (Model.Lines != null && Model.Lines.Any())
                    {
                        for (int i = 0; i < Model.Lines.Count; i++)
                        {
                            var line = Model.Lines[i];

                            <tr class="outbound-line">

                                <td>

                                    <input type="hidden"
                                           name="Lines[@i].Id"
                                           value="@line.Id" />

                                    <input type="hidden"
                                           name="Lines[@i].ProductId"
                                           class="line-product-id"
                                           value="@line.ProductId" />

                                    @if (canEdit)
                                    {
                                        <div class="input-group">

                                            <input type="text"
                                                   class="form-control product-search"
                                                   value="@line.ProductDisplay"
                                                   placeholder="Barcode / mã / ISBN / tên"
                                                   autocomplete="off" />

                                            <button type="button"
                                                    class="btn btn-outline-secondary btn-scan-product">

                                                <i class="bi bi-upc-scan"></i>

                                            </button>

                                        </div>
                                    }
                                    else
                                    {
                                        <span>
                                            @line.ProductDisplay
                                        </span>
                                    }

                                </td>


                                <td>

                                    <span class="line-product-barcode">
                                        @line.ProductBarcode
                                    </span>

                                </td>


                                <td>

                                    <input type="hidden"
                                           name="Lines[@i].LocationId"
                                           class="line-location-id"
                                           value="@line.LocationId" />

                                    @if (canEdit)
                                    {
                                        <div class="input-group">

                                            <input type="text"
                                                   class="form-control location-search"
                                                   value="@line.LocationDisplay"
                                                   placeholder="Barcode / mã Bin"
                                                   autocomplete="off" />

                                            <button type="button"
                                                    class="btn btn-outline-secondary btn-scan-location">

                                                <i class="bi bi-upc-scan"></i>

                                            </button>

                                        </div>
                                    }
                                    else
                                    {
                                        <span>
                                            @line.LocationDisplay
                                        </span>
                                    }

                                </td>


                                <td class="text-end">

                                    <span class="line-bin-stock">
                                        @line.BinStock
                                    </span>

                                </td>


                                <td>

                                    <input type="number"
                                           name="Lines[@i].RequestedQty"
                                           class="form-control text-end line-requested-qty"
                                           value="@line.RequestedQty"
                                           min="1"
                                           disabled="@(!canEdit)" />

                                </td>


                                <td>

                                    <input type="number"
                                           name="Lines[@i].PickedQty"
                                           class="form-control text-end line-picked-qty"
                                           value="@line.PickedQty"
                                           min="0"
                                           disabled="@(Model.Status != "PICKING")" />

                                </td>


                                <td class="text-center">

                                    @if (canEdit)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger btn-remove-line">

                                            <i class="bi bi-trash"></i>

                                        </button>
                                    }

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>


        @if (canEdit)
        {
            <div id="outboundEmptyMessage"
                 class="text-center text-muted py-4"
                 style="@(Model.Lines != null && Model.Lines.Any() ? "display:none;" : "")">

                <i class="bi bi-box-seam fs-2 d-block mb-2"></i>

                Chưa có sản phẩm.
                Nhấn <strong>Thêm dòng</strong> để bắt đầu.

            </div>
        }

    </div>


    <!-- ACTION -->
    <div class="card-footer bg-white">

        <div class="d-flex justify-content-between align-items-center">

            <a asp-controller="Outbound"
               asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left"></i>
                Quay lại

            </a>


            <div class="d-flex gap-2">

                @if (Model.Status == "DRAFT")
                {
                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-save"></i>
                        Lưu nháp

                    </button>

                    @if (Model.Id > 0)
                    {
                        <button type="button"
                                class="btn btn-success"
                                id="btnStartPicking"
                                data-id="@Model.Id">

                            <i class="bi bi-box-arrow-down"></i>
                            Bắt đầu lấy hàng

                        </button>
                    }
                }


                @if (Model.Status == "PICKING")
                {
                    <button type="button"
                            class="btn btn-success"
                            id="btnCompleteOutbound"
                            data-id="@Model.Id">

                        <i class="bi bi-check-lg"></i>
                        Hoàn tất xuất

                    </button>
                }


                @if (Model.Status == "DRAFT"
                    || Model.Status == "PICKING")
                {
                    <button type="button"
                            class="btn btn-outline-danger"
                            id="btnCancelOutbound"
                            data-id="@Model.Id">

                        <i class="bi bi-x-lg"></i>
                        Hủy phiếu

                    </button>
                }

            </div>

        </div>

    </div>

</div>


<!-- PRODUCT SEARCH RESULT -->
<div id="productSearchResult"
     class="search-dropdown shadow-sm"
     style="display:none;">
</div>


<!-- LOCATION SEARCH RESULT -->
<div id="locationSearchResult"
     class="search-dropdown shadow-sm"
     style="display:none;">
</div>
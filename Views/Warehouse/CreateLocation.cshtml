@model StationeryWarehouse.Models.Warehouse.LocationFormViewModel

@{
    ViewData["Title"] = "Tạo vị trí";

    var warehouses =
        ViewBag.Warehouses as
        List<StationeryWarehouse.Models.Warehouse.WarehouseListViewModel>
        ?? new();

    var parents =
        ViewBag.ParentLocations as
        List<StationeryWarehouse.Models.Warehouse.LocationListViewModel>
        ?? new();
}

<div class="erp-page">

    <div class="erp-page-header">

        <div>
            <h1 class="erp-page-title">
                Tạo vị trí
            </h1>

            <div class="text-muted">
                Tạo khu vực hoặc Bin lưu trữ
            </div>
        </div>

    </div>

    <div class="card erp-card">

        <div class="card-body">

            <form asp-action="CreateLocation"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="WarehouseId"
                               class="form-label">
                        </label>

                        <select asp-for="WarehouseId"
                                class="form-select">

                            <option value="">
                                -- Chọn kho --
                            </option>

                            @foreach (var warehouse in warehouses)
                            {
                                <option value="@warehouse.Id">
                                    @warehouse.Code -
                                    @warehouse.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="WarehouseId"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="LocationType"
                               class="form-label">
                        </label>

                        <select asp-for="LocationType"
                                class="form-select">

                            <option value="AREA">
                                AREA - Khu vực
                            </option>

                            <option value="BIN">
                                BIN - Vị trí chứa hàng
                            </option>

                        </select>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Code"
                               class="form-label">
                        </label>

                        <input asp-for="Code"
                               class="form-control"
                               placeholder="VD: A1-01" />

                        <span asp-validation-for="Code"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Name"
                               class="form-label">
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="VD: Kệ A1 tầng 01" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="ParentId"
                           class="form-label">
                    </label>

                    <select asp-for="ParentId"
                            class="form-select">

                        <option value="">
                            -- Không có vị trí cha --
                        </option>

                        @foreach (var parent in parents)
                        {
                            <option value="@parent.Id">
                                @parent.Code -
                                @parent.Name
                            </option>
                        }

                    </select>

                </div>

                <div class="mb-4">

                    <label asp-for="Barcode"
                           class="form-label">
                    </label>

                    <input asp-for="Barcode"
                           class="form-control"
                           placeholder="VD: LOC-A1-01" />

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Lưu
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Hủy
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model StationeryWarehouse.Models.Settings.SettingsIndexViewModel

@{
    ViewData["Title"] = "Cài đặt";
    var rolesTabActive = Context.Request.Query["tab"] == "roles";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <div class="text-muted small">
                Quản lý kho / Cài đặt
            </div>

            <h1 class="h3 mb-1">
                Cài đặt
            </h1>

            <div class="text-muted">
                Quản lý người dùng và vai trò hệ thống
            </div>
        </div>
    </div>


    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }


    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <ul class="nav nav-tabs card-header-tabs">

                <li class="nav-item">
                    <button
                        class="nav-link @(rolesTabActive ? "" : "active")"
                        data-bs-toggle="tab"
                        data-bs-target="#users-tab"
                        type="button">

                        Người dùng
                    </button>
                </li>

                <li class="nav-item">
                    <button
                        class="nav-link @(rolesTabActive ? "active" : "")"
                        data-bs-toggle="tab"
                        data-bs-target="#roles-tab"
                        type="button">

                        Vai trò
                    </button>
                </li>

            </ul>

        </div>


        <div class="card-body">

            <div class="tab-content">

                <!-- ================================================= -->
                <!-- USERS -->
                <!-- ================================================= -->

                <div
                    class="tab-pane fade @(!rolesTabActive ? "show active" : "")"
                    id="users-tab">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <div>
                            <h5 class="mb-1">
                                Người dùng
                            </h5>

                            <div class="text-muted small">
                                Quản lý tài khoản truy cập hệ thống
                            </div>
                        </div>

                        <a
                            asp-action="CreateUser"
                            class="btn btn-primary">

                            <i class="bi bi-plus-lg"></i>
                            Thêm người dùng

                        </a>

                    </div>


                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead class="table-light">

                                <tr>
                                    <th>Username</th>
                                    <th>Họ tên</th>
                                    <th>Vai trò</th>
                                    <th>Trạng thái</th>
                                    <th>Ngày tạo</th>
                                    <th class="text-end">Thao tác</th>
                                </tr>

                            </thead>


                            <tbody>

                                @if (!Model.Users.Any())
                                {
                                    <tr>
                                        <td
                                            colspan="6"
                                            class="text-center text-muted py-4">

                                            Chưa có người dùng.

                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var user in Model.Users)
                                    {
                                        <tr>

                                            <td>
                                                <strong>
                                                    @user.Username
                                                </strong>
                                            </td>

                                            <td>
                                                @user.FullName
                                            </td>

                                            <td>
                                                <span class="badge text-bg-secondary">
                                                    @user.RoleCode
                                                </span>

                                                <div class="small text-muted">
                                                    @user.RoleName
                                                </div>
                                            </td>

                                            <td>
                                                @if (user.IsActive)
                                                {
                                                    <span class="badge erp-status-badge erp-status-active">
                                                        Active
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge erp-status-badge erp-status-inactive">
                                                        Inactive
                                                    </span>
                                                }
                                            </td>

                                            <td>
                                                @user.CreatedAt.ToLocalTime()
                                                    .ToString("dd/MM/yyyy HH:mm")
                                            </td>

                                            <td class="text-end">

                                                <div class="btn-group">

                                                    <a
                                                        asp-action="EditUser"
                                                        asp-route-id="@user.Id"
                                                        class="btn btn-sm btn-outline-primary">

                                                        Sửa

                                                    </a>

                                                    <a
                                                        asp-action="ChangePassword"
                                                        asp-route-id="@user.Id"
                                                        class="btn btn-sm btn-outline-secondary">

                                                        Đổi mật khẩu

                                                    </a>

                                                    <form
                                                        asp-action="ToggleUser"
                                                        method="post"
                                                        class="d-inline">

                                                        @Html.AntiForgeryToken()

                                                        <input
                                                            type="hidden"
                                                            name="id"
                                                            value="@user.Id" />

                                                        <button
                                                            type="submit"
                                                            class="btn btn-sm btn-outline-warning">

                                                            @(user.IsActive
                                                                ? "Khóa"
                                                                : "Mở khóa")

                                                        </button>

                                                    </form>

                                                </div>

                                            </td>

                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>

                    </div>

                    <div class="card-footer bg-white">
                        @await Html.PartialAsync(
                            "_Pagination",
                            Model.UsersPagination)
                    </div>

                </div>


                <!-- ================================================= -->
                <!-- ROLES -->
                <!-- ================================================= -->

                <div
                    class="tab-pane fade @(rolesTabActive ? "show active" : "")"
                    id="roles-tab">

                    <div class="mb-3">

                        <h5 class="mb-1">
                            Vai trò
                        </h5>

                        <div class="text-muted small">
                            Các vai trò chuẩn của hệ thống
                        </div>

                    </div>


                    <div class="table-responsive">

                        <table class="table table-hover align-middle">

                            <thead class="table-light">

                                <tr>
                                    <th>Mã</th>
                                    <th>Tên vai trò</th>
                                    <th>Số người dùng</th>
                                    <th>Trạng thái</th>
                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var role in Model.Roles)
                                {
                                    <tr>

                                        <td>
                                            <strong>
                                                @role.Code
                                            </strong>
                                        </td>

                                        <td>
                                            @role.Name
                                        </td>

                                        <td>
                                            @role.UserCount
                                        </td>

                                        <td>

                                            @if (role.IsActive)
                                            {
                                                <span class="badge erp-status-badge erp-status-active">
                                                    Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge erp-status-badge erp-status-inactive">
                                                    Inactive
                                                </span>
                                            }

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                    <div class="card-footer bg-white">
                        @await Html.PartialAsync(
                            "_Pagination",
                            Model.RolesPagination)
                    </div>

                    <div class="alert alert-info mt-3 mb-0">

                        <strong>Lưu ý:</strong>
                        Hệ thống sử dụng 4 vai trò chuẩn.
                        Không hỗ trợ tạo permission động trong phiên bản này.

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
@{
    var displayName = User.FindFirst("FullName")?.Value;

    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = User.Identity?.Name;
    }

    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = "Tài khoản";
    }

    var avatarInitial =
        displayName[..1].ToUpperInvariant();
}

<header class="erp-topbar">

    <!-- LEFT -->
    <div class="erp-topbar-left">

        <button type="button"
                class="erp-sidebar-toggle"
                id="sidebarToggle"
                title="Mở hoặc thu gọn menu"
                aria-label="Mở hoặc thu gọn menu"
                aria-controls="erpSidebar"
                aria-expanded="false">

            ☰

        </button>


        <div class="erp-topbar-system">
            Quản lý kho
        </div>

    </div>


    <!-- SEARCH -->
    <div class="erp-global-search">

        <span class="erp-search-icon">
            🔍
        </span>

        <input type="text"
               class="form-control"
               placeholder="Tìm kiếm..." />

    </div>


    <!-- RIGHT -->
    <div class="erp-topbar-right">

        <!-- Notification -->
        <button class="erp-topbar-button"
                type="button"
                title="Thông báo"
                aria-label="Thông báo">

            🔔

        </button>


        <!-- User -->
        <div class="dropdown">

            <button class="erp-user-button dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-label="Menu tài khoản">

                <span class="erp-avatar">
                    @avatarInitial
                </span>

                <span class="erp-user-name">
                    @displayName
                </span>

            </button>


            <ul class="dropdown-menu dropdown-menu-end">

                @if (User.IsInRole("ADMIN"))
                {
                    <li>
                        <a class="dropdown-item"
                           asp-controller="Settings"
                           asp-action="Index">
                            Cài đặt
                        </a>
                    </li>
                }

                <li>
                    <hr class="dropdown-divider" />
                </li>

                <li>
                    <form asp-controller="Auth"
                          asp-action="Logout"
                          method="post">

                        <button type="submit"
                                class="dropdown-item">

                            Đăng xuất

                        </button>

                    </form>
                </li>

            </ul>

        </div>

    </div>

</header>
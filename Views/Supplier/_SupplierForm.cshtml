@model StationeryWarehouse.Models.Supplier.SupplierFormViewModel

@if (Model.Id > 0)
{
    <input asp-for="Id" type="hidden" />
}

<div asp-validation-summary="ModelOnly"
     class="text-danger mb-3">
</div>


<div class="card shadow-sm mb-4">

    <div class="card-header">
        <strong>Thông tin nhà cung cấp / NXB</strong>
    </div>

    <div class="card-body">

        <div class="row g-3">

            <!-- CODE -->
            <div class="col-md-4">

                <label asp-for="Code"
                       class="form-label">
                    Mã
                </label>

                <input asp-for="Code"
                       class="form-control"
                       placeholder="VD: NXB-TRE" />

                <span asp-validation-for="Code"
                      class="text-danger">
                </span>

            </div>


            <!-- NAME -->
            <div class="col-md-8">

                <label asp-for="Name"
                       class="form-label">
                    Tên
                </label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="Tên nhà cung cấp / NXB" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>

            </div>


            <!-- TYPE -->
            <div class="col-md-4">

                <label asp-for="Type"
                       class="form-label">
                    Loại
                </label>

                <select asp-for="Type"
                        class="form-select">

                    <option value="PUBLISHER">
                        Nhà xuất bản
                    </option>

                    <option value="SUPPLIER">
                        Nhà cung cấp
                    </option>

                    <option value="BOTH">
                        Cả hai
                    </option>

                </select>

                <span asp-validation-for="Type"
                      class="text-danger">
                </span>

            </div>


            <!-- CONTACT -->
            <div class="col-md-4">

                <label asp-for="ContactPerson"
                       class="form-label">
                    Người liên hệ
                </label>

                <input asp-for="ContactPerson"
                       class="form-control" />

                <span asp-validation-for="ContactPerson"
                      class="text-danger">
                </span>

            </div>


            <!-- PHONE -->
            <div class="col-md-4">

                <label asp-for="Phone"
                       class="form-label">
                    Điện thoại
                </label>

                <input asp-for="Phone"
                       class="form-control" />

                <span asp-validation-for="Phone"
                      class="text-danger">
                </span>

            </div>


            <!-- ADDRESS -->
            <div class="col-md-12">

                <label asp-for="Address"
                       class="form-label">
                    Địa chỉ
                </label>

                <textarea asp-for="Address"
                          class="form-control"
                          rows="2">
                </textarea>

                <span asp-validation-for="Address"
                      class="text-danger">
                </span>

            </div>


            <!-- EMAIL -->
            <div class="col-md-6">

                <label asp-for="Email"
                       class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       type="email"
                       class="form-control" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>


            <!-- NOTES -->
            <div class="col-md-6">

                <label asp-for="Notes"
                       class="form-label">
                    Ghi chú
                </label>

                <textarea asp-for="Notes"
                          class="form-control"
                          rows="2">
                </textarea>

                <span asp-validation-for="Notes"
                      class="text-danger">
                </span>

            </div>

        </div>

    </div>

</div>